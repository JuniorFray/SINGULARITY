:root {
    --bg-color: #e5e5e5;
    --canvas-bg: #d4d4d4;
    --text-color: #333333;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #f0f0f0;
    color: var(--text-color);
    font-family: sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    overflow: hidden;
}

main {
    position: relative;
    width: 100%;
    max-width: 800px;
    aspect-ratio: 16 / 9;
}

canvas {
    width: 100%;
    height: 100%;
    background-color: var(--canvas-bg);
    display: block;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

#ui {
    position: absolute;
    top: 10px;
    left: 10px;
    font-weight: bold;
    pointer-events: none;
}